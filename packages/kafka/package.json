{
  "name": "@repo/kafka",
  "version": "1.0.0",
  "description": "A package for sharing kafka producers and workers.",
  "license": "ISC",
  "author": "Krishil Jayswal",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./producer": {
      "default": "./dist/producer.js",
      "types": "./src/producer.ts"
    },
    "./consumer": {
      "default": "./dist/consumer.js",
      "types": "./src/consumer.ts"
    },
    "./meta": {
      "default": "./dist/meta.js",
      "types": "./src/meta.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc -b"
  },
  "dependencies": {
    "@repo/env": "*",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "*"
  }
}
