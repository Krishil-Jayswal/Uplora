generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String
  avatarUrl      String
  oauthId        String
  oauthType      Oauth_Type
  installationId String?
  projects       Project[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([oauthType, oauthId])
}

model Project {
  id       String @id @default(uuid())
  name     String
  repoUrl  String
  status   Status
  ownerId  String
  slug     String @unique
  metadata String
  owner    User   @relation(fields: [ownerId], references: [id])
}

enum Status {
  cloning
  building
  deployed
  failed
}

enum Oauth_Type {
  GITHUB
  GOOGLE
}
