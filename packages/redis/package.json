{
  "name": "@repo/redis",
  "version": "1.0.0",
  "description": "A package for delivering redis clients.",
  "license": "ISC",
  "author": "Krishil Jayswal",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc -b"
  },
  "exports": {
    "./publisher": {
      "default": "./dist/publisher.js",
      "types": "./src/publisher.ts"
    },
    "./subscriber": {
      "default": "./dist/subscriber.js",
      "types": "./src/subscriber.ts"
    },
    "./managers": {
      "default": "./dist/managers/index.js",
      "types": "./src/managers/index.ts"
    }
  },
  "dependencies": {
    "ioredis": "^5.6.1",
    "@repo/env": "*"
  },
  "devDependencies": {
    "@repo/typescript-config": "*"
  }
}
